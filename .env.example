# Copy to .env (or export these) - see README "Configuration".
#
# Defaults already work with no key at all: zen-free is anonymous.
# TYPESAFE_API_KEY=xxx        # direct TypeSafe (console.typesafe.ai/keys), model jev-1.13.0
# OPENCODE_API_KEY=xxx        # OpenCode Zen paid jev-1.13 (opencode.ai/auth)

# Overrides (all optional):
# JEV_BASE_URL=https://opencode.ai/zen/v1/systemone
# JEV_MODEL=jev-1.13-free     # jev-1.13-free | jev-1.13 | jev-1.13.0
# JEV_TIMEOUT_MS=10000        # deadline for one scoring call; the hook fails open after this
# CLINE_HOOKS_DIR=~/.cline/hooks   # where scripts/install-hook.mjs writes PreToolUse.js
# CLINE_HOOK_LOG_DIR=~/.cline/data/logs  # where the hook appends jev-hook.jsonl

JEV_MODEL=
