{
  "name": "@donbee/cline-plugin-jev-percent",
  "version": "0.3.1",
  "description": "Add percentage to each Cline ask_question / ask_followup_question option using Jev 1.13",
  "type": "module",
  "main": "cline-plugin.js",
  "bin": {
    "jev-cline-option-scorer": "src/cli.js",
    "jev-cline-install-hook": "scripts/install-hook.mjs"
  },
  "cline": {
    "plugins": [
      {
        "paths": [
          "./cline-plugin.js"
        ],
        "capabilities": [
          "tools",
          "hooks"
        ]
      }
    ]
  },
  "peerDependencies": {
    "@cline/sdk": "*"
  },
  "peerDependenciesMeta": {
    "@cline/sdk": {
      "optional": true
    }
  },
  "scripts": {
    "install:hook": "node scripts/install-hook.mjs",
    "prepack": "node scripts/install-hook.mjs --dir hooks --quiet",
    "check": "node --check hooks/PreToolUse.cjs && node --check hooks/PostToolUse.cjs && node --check cline-plugin.js && node --check src/jev-client.js && node --check src/cli.js && node --check src/cline-interceptor.js && node --check scripts/install-hook.mjs && node --check scripts/smoke-fresh-install.mjs",
    "test": "node --test tests/*.mjs",
    "smoke": "node scripts/smoke-fresh-install.mjs",
    "verify": "npm run check && npm test",
    "prepublishOnly": "npm run verify && npm run smoke"
  },
  "files": [
    "src/",
    "hooks/",
    "scripts/",
    "skills/",
    "cline-plugin.js",
    "README.md",
    ".clinerules",
    "LICENSE"
  ],
  "keywords": [
    "cline",
    "jev",
    "typesafe",
    "opencode-zen",
    "choice",
    "hook",
    "plugin"
  ],
  "author": "donbee",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saahmadnejad/cline-option-scorer.git",
    "directory": "packages/cline-plugin"
  },
  "homepage": "https://github.com/saahmadnejad/cline-option-scorer/tree/main/packages/cline-plugin#readme",
  "bugs": {
    "url": "https://github.com/saahmadnejad/cline-option-scorer/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.5"
  }
}
