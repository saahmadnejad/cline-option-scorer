{
  "name": "@donbee/jev-mcp",
  "version": "0.3.1",
  "description": "General-purpose MCP server and CLI to score option probabilities using Jev 1.13",
  "type": "module",
  "main": "src/jev-client.js",
  "bin": {
    "jev-option-scorer": "src/cli.js",
    "jev-mcp": "src/mcp-server.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "test": "node --test tests/*.mjs",
    "check": "node --check src/mcp-server.js && node --check src/jev-client.js && node --check src/cli.js && node --check src/jev-config.js && node --check scripts/smoke-fresh-install.mjs",
    "smoke": "node scripts/smoke-fresh-install.mjs",
    "verify": "npm run check && npm test",
    "prepublishOnly": "npm run verify && npm run smoke"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "jev",
    "mcp",
    "model-context-protocol",
    "typesafe",
    "opencode-zen",
    "probabilities",
    "decision-making"
  ],
  "author": "donbee",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saahmadnejad/cline-option-scorer.git",
    "directory": "packages/jev-mcp"
  },
  "homepage": "https://github.com/saahmadnejad/cline-option-scorer/tree/main/packages/jev-mcp#readme",
  "bugs": {
    "url": "https://github.com/saahmadnejad/cline-option-scorer/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
